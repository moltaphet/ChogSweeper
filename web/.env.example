NEXT_PUBLIC_CHOGSWEEPER_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_CHOG_COLLECTION=
# Comma separated extra ERC721Enumerable collections to scan
NEXT_PUBLIC_COLLECTIONS=
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# --- Indexer-backed API (server only) ---
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- NFT discovery & metadata (server only) ---
# Verified collection registry used when the indexer database is unavailable: address:ecosystem[:startBlock]
VERIFIED_COLLECTIONS=
# Comma separated IPFS gateways. Default: ipfs.io, dweb.link, gateway.pinata.cloud, 4everland.io, w3s.link.
# NOTE: as of this writing ipfs.io / dweb.link / w3s.link answer plain HTTP with 429 ("service worker gateway only"), so Pinata and
# 4everland do the work. Gateways that fail are demoted automatically. For production, set a DEDICATED gateway first, e.g.
# IPFS_GATEWAYS=https://<your-name>.mypinata.cloud/ipfs/,https://ipfs.io/ipfs/
IPFS_GATEWAYS=
# Chain the indexer database describes (DB-backed shortcuts only apply to this chain)
INDEXER_CHAIN_ID=10143
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# Log-scan fallback for collections without ERC721Enumerable
INVENTORY_LOG_LOOKBACK=500000
INVENTORY_LOG_MAX_RANGE=50000

# --- Site footer links (shown only when set; nothing is guessed) ---
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CHOG_DISCORD_URL=
NEXT_PUBLIC_CHOG_X_URL=

# --- Testnet faucet link shown on the Test Faucet tab (default https://faucet.monad.xyz) ---
NEXT_PUBLIC_FAUCET_URL=
