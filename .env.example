# ChogSweeper deployment. Copy to `.env` (git-ignored) and fill in. NEVER commit a real key.

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/
# Deployer key: funded with testnet MON from the faucet. Becomes the initial owner.
PRIVATE_KEY=

# Flat taker fee in wei. 0 = free (recommended for testnet). 0.05 MON = 50000000000000000
PLATFORM_FEE_WEI=0
# Defaults to the deployer when omitted
TREASURY_ADDRESS=
# If set and different from the deployer, ownership transfer is started and must be accepted by this address
OWNER_ADDRESS=

# Use an existing Chog contract for the holder fee exemption, OR leave empty to deploy MockChog
CHOG_COLLECTION=
# Default: true when CHOG_COLLECTION is empty
DEPLOY_MOCK_CHOG=
# Mint mock Chogs to these wallets right after deploying (comma separated)
SEED_MINT_TO=
SEED_MINT_COUNT=2
