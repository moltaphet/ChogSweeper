# --- Chain ---
# Comma separated; requests fail over in order.
RPC_URLS=https://testnet-rpc.monad.xyz
# Optional WebSocket endpoint used only as a low-latency "new block" signal. Polling continues regardless.
WS_URL=
CHAIN_ID=10143
SWEEPER_ADDRESS=
SWEEPER_DEPLOY_BLOCK=0
# Blocks to wait behind head before indexing (reorg safety).
CONFIRMATIONS=2
# Max eth_getLogs range per request. Public RPCs often cap this.
MAX_BLOCK_RANGE=100
POLL_MS=500

# --- Storage ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chogsweeper
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- NFT metadata ---
# address[:startBlock] entries, comma separated. The Chog collection is flagged via CHOG_COLLECTION.
# address[:startBlock[:ecosystem]]; ecosystem (chog|monad) marks the collection as verified in the UI.
COLLECTIONS=
CHOG_COLLECTION=
# Comma separated IPFS gateways, tried in order (a slow one is hedged by the next). Default: ipfs.io, dweb.link, w3s.link
IPFS_GATEWAYS=
METADATA_CONCURRENCY=8

HEALTH_PORT=8080
